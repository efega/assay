{
  "name": "roost",
  "displayName": "Roost \u2014 HTTP client with tests",
  "description": "Run .http files, assert on the response, chain requests. No account, no cloud, no limits.",
  "version": "0.0.1",
  "publisher": "roost",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "curl",
    "http file",
    "rest file",
    "endpoint testing",
    "http",
    "rest",
    "api",
    "api client",
    "http client",
    "rest client",
    "api testing",
    "testing",
    "assertions",
    "request",
    "postman",
    "insomnia",
    "thunder client",
    "bruno",
    "graphql",
    "openapi"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:http"
  ],
  "contributes": {
    "languages": [
      {
        "id": "http",
        "aliases": [
          "HTTP",
          "http"
        ],
        "extensions": [
          ".http",
          ".rest"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "roost.enviarBajoCursor",
        "title": "Send request",
        "category": "Roost"
      },
      {
        "command": "roost.limpiarCadena",
        "title": "Reset chain (discard saved responses)",
        "category": "Roost"
      },
      {
        "command": "roost.seleccionarEntorno",
        "title": "Select environment",
        "category": "Roost"
      }
    ],
    "keybindings": [
      {
        "command": "roost.enviarBajoCursor",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus && editorLangId == http"
      }
    ],
    "configuration": {
      "title": "Roost",
      "properties": {
        "roost.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "description": "How long to wait for a response, in milliseconds."
        },
        "roost.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Mask credential-looking query parameters and headers in the response panel and log."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . -w",
    "test:unit": "tsc -p . && node --test out/test/unit/*.test.js",
    "test:integration": "tsc -p . && vscode-test",
    "test": "npm run test:unit && npm run test:integration",
    "vsce:package": "npm test && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "mocha": "^11.8.0",
    "typescript": "^5.4.0"
  },
  "galleryBanner": {
    "color": "#1F2A24",
    "theme": "dark"
  },
  "qna": "marketplace",
  "badges": [],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/TU-USUARIO/roost.git"
  },
  "bugs": {
    "url": "https://github.com/TU-USUARIO/roost/issues"
  },
  "homepage": "https://github.com/TU-USUARIO/roost#readme"
}
