# Fichero de ejemplo. Texto plano, versionable en git, tuyo.
# Pulsa "Enviar" sobre cualquier peticion, o Ctrl+Alt+R con el cursor dentro.

@base = https://httpbin.org
@token = un-token-de-ejemplo

### Consulta simple con parametros
GET {{base}}/get
  ?rol=admin
  &activo=true
Accept: application/json

### Peticion con cabecera de autorizacion
# @name perfil
GET {{base}}/bearer
Authorization: Bearer {{token}}

### Envio de JSON
POST {{base}}/post
Content-Type: application/json

{
  "nombre": "Ana",
  "rol": "admin"
}

### Comprobar un codigo de error
GET {{base}}/status/404

### Con asertos: la respuesta se verifica sola
# @name conAsertos
# @assert status 200
# @assert time < 5000
# @assert header.content-type contains json
# @assert body.$.headers.Accept exists
GET {{base}}/get
Accept: application/json

### Encadenado: esta peticion produce un valor
# @name origen
POST {{base}}/post
Content-Type: application/json

{"token": "T0K3N-DE-EJEMPLO", "id": 42}

### Y esta lo consume. Ejecuta solo esta: la de arriba se lanza sola.
GET {{base}}/anything/{{origen.response.body.$.json.id}}
Authorization: Bearer {{origen.response.body.$.json.token}}
# @assert status 200
# @assert body.$.headers.Authorization contains T0K3N
